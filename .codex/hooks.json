{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/travis/Development/open-source/humanise/.codex/hooks/guard-bash.sh'",
            "timeout": 15,
            "statusMessage": "Checking command for supply-chain and secret risks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/travis/Development/open-source/humanise/.codex/hooks/post-edit.sh'",
            "timeout": 120,
            "statusMessage": "Dogfooding the humanise checker on docs"
          }
        ]
      }
    ]
  }
}
